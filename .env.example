# APP_URL: Public URL of the deployed application (automatically set on Vercel via VERCEL_URL or custom domain)
APP_URL=""

# SESSION_SECRET: Optional 32+ character secret for signing stateless encrypted Apple ID session tokens and OTA manifest links.
# Recommended when deploying to Vercel so sessions persist smoothly across serverless function cold starts.
SESSION_SECRET=""

# SAP_BRIDGE_URL: Optional HTTPS URL of the self-hosted FairPlay SAP Bridge (see /companion/Dockerfile)
# required for direct Apple ID login + 2FA from Vercel Serverless.
SAP_BRIDGE_URL=""

# SAP_BRIDGE_SECRET: Optional Bearer secret protecting the FairPlay SAP Bridge.
SAP_BRIDGE_SECRET=""

